# Copy to server/.env (or export vars). ambit: local demo works with zero setup via USE_MEMORY_DB.
PORT=5000
# Preferred name (falls back to MONGODB_URI for backwards compat)
MONGO_URI=
MONGODB_URI=mongodb://127.0.0.1:27017/smart-warehouse
# Local zero-setup demo: in-memory Mongo + auto-seed. Set false when MONGO_URI points to Atlas.
USE_MEMORY_DB=true
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Operational Email & Notification Dispatcher (Optional: can also be set in Settings UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WareX Central WMS" <notifications@warex-wms.local>
NOTIFICATION_EMAIL=
